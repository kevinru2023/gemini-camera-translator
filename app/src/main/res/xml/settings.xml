<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory>
        <ListPreference
            app:key="target_language"
            app:title="Translate to"
            app:defaultValue="English"
            app:entries="@array/language_names"
            app:entryValues="@array/language_values"
            app:useSimpleSummaryProvider="true"
            />

        <EditTextPreference
            app:key="font_size"
            app:title="Font Size"
            app:defaultValue="18"
            app:useSimpleSummaryProvider="true"
            />
    </PreferenceCategory>
</PreferenceScreen>
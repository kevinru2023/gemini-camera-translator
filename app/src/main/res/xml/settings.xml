    <PreferenceCategory>
        <ListPreference
            app:key="target_language"
            app:title="Translate to"
            app:defaultValue="Spanish"
            app:entries="@array/language_names"
            app:entryValues="@array/language_values"
            app:useSimpleSummaryProvider="true"
            />
    </PreferenceCategory>
</PreferenceScreen>
<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/home_screen">

    <action
        android:id="@+id/navigate_to_settings"
        app:destination="@+id/settings"/>

    <action
        android:id="@+id/navigate_to_home_screen"
        app:destination="@id/home_screen"/>

    <fragment
        android:id="@+id/home_screen"
        android:label="@string/label_home_screen"
        android:name="com.example.final_project_cs492_team27.ui.HomeScreenFragment"/>

    <fragment
        android:id="@+id/translation_history"
        android:label="@string/label_history"
        android:name="com.example.final_project_cs492_team27.ui.TranslationHistoryFragment"/>

    <fragment
        android:id="@+id/settings"
        android:label="@string/label_settings"
        android:name="com.example.final_project_cs492_team27.ui.SettingsFragment"/>


</navigation>